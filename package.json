{
	"name": "paths-le",
	"publisher": "nolindnaidoo",
	"displayName": "Paths-LE",
	"description": "Zero Hassle file path extraction from JavaScript, TypeScript, JSON, HTML, CSS, TOML, CSV, and ENV files",
	"version": "2.0.1",
	"license": "MIT",
	"author": {
		"name": "nolindnaidoo",
		"url": "https://github.com/nolindnaidoo"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/nolindnaidoo/paths-le.git"
	},
	"bugs": {
		"url": "https://github.com/nolindnaidoo/paths-le/issues"
	},
	"homepage": "https://letools.dev",
	"engines": {
		"vscode": "^1.90.0",
		"node": ">=20.0.0"
	},
	"categories": [
		"Programming Languages",
		"Linters",
		"Formatters"
	],
	"keywords": [
		"path",
		"paths",
		"file",
		"files",
		"extract",
		"extractor",
		"extraction",
		"import",
		"imports",
		"dependencies",
		"dependency-analysis",
		"module",
		"require",
		"relative-path",
		"asset",
		"assets",
		"filesystem",
		"monorepo",
		"refactor",
		"audit",
		"unused-files",
		"config",
		"json",
		"jsonc",
		"html",
		"css",
		"toml",
		"csv",
		"dotenv",
		"env"
	],
	"icon": "src/assets/images/icon.png",
	"main": "./dist/extension.js",
	"activationEvents": [
		"onLanguage:csv",
		"onLanguage:toml",
		"onLanguage:dotenv",
		"onLanguage:env",
		"onLanguage:javascript",
		"onLanguage:javascriptreact",
		"onLanguage:typescript",
		"onLanguage:typescriptreact",
		"onLanguage:json",
		"onLanguage:jsonc",
		"onLanguage:html",
		"onLanguage:css",
		"onLanguage:scss",
		"onLanguage:less"
	],
	"capabilities": {
		"virtualWorkspaces": {
			"supported": "limited",
			"description": "%manifest.capability.untrusted-workspaces.desc%"
		},
		"untrustedWorkspaces": {
			"supported": "limited",
			"description": "%manifest.capability.untrusted-workspaces.desc%"
		}
	},
	"contributes": {
		"commands": [
			{
				"command": "paths-le.extractPaths",
				"title": "%manifest.command.extract.title%",
				"category": "%manifest.command.category%"
			},
			{
				"command": "paths-le.postProcess.dedupe",
				"title": "%manifest.command.dedupe.title%",
				"category": "%manifest.command.category%"
			},
			{
				"command": "paths-le.postProcess.sort",
				"title": "%manifest.command.sort.title%",
				"category": "%manifest.command.category%"
			},
			{
				"command": "paths-le.openSettings",
				"title": "%manifest.command.settings.title%",
				"category": "%manifest.command.category%"
			},
			{
				"command": "paths-le.help",
				"title": "%manifest.command.help.title%",
				"category": "%manifest.command.category%"
			}
		],
		"keybindings": [
			{
				"command": "paths-le.extractPaths",
				"key": "ctrl+alt+p",
				"mac": "cmd+alt+p",
				"when": "editorTextFocus"
			}
		],
		"menus": {
			"editor/context": [
				{
					"command": "paths-le.extractPaths",
					"when": "editorLangId =~ /^(javascript|javascriptreact|typescript|typescriptreact|json|jsonc|html|css|scss|less|csv|toml|dotenv|env)$/",
					"group": "1_modification@1"
				}
			],
			"commandPalette": [
				{
					"command": "paths-le.extractPaths"
				},
				{
					"command": "paths-le.postProcess.dedupe"
				},
				{
					"command": "paths-le.postProcess.sort"
				},
				{
					"command": "paths-le.openSettings"
				},
				{
					"command": "paths-le.help"
				}
			]
		},
		"configuration": {
			"title": "%manifest.settings.title%",
			"properties": {
				"paths-le.copyToClipboardEnabled": {
					"type": "boolean",
					"default": false,
					"description": "%manifest.settings.copy.clipboard.desc%"
				},
				"paths-le.notificationsLevel": {
					"type": "string",
					"default": "silent",
					"enum": [
						"all",
						"important",
						"silent"
					],
					"enumDescriptions": [
						"%manifest.settings.notifications.level.option.all%",
						"%manifest.settings.notifications.level.option.important%",
						"%manifest.settings.notifications.level.option.silent%"
					],
					"description": "%manifest.settings.notifications.level.desc%"
				},
				"paths-le.postProcess.openInNewFile": {
					"type": "boolean",
					"default": true,
					"description": "%manifest.settings.open.new-file.desc%"
				},
				"paths-le.openResultsSideBySide": {
					"type": "boolean",
					"default": true,
					"description": "%manifest.settings.open.side-by-side.desc%"
				},
				"paths-le.safety.enabled": {
					"type": "boolean",
					"default": true,
					"description": "%manifest.settings.safety.enabled.desc%"
				},
				"paths-le.safety.fileSizeWarnBytes": {
					"type": "number",
					"default": 1e6,
					"minimum": 1000,
					"description": "%manifest.settings.safety.warn.file-size.desc%"
				},
				"paths-le.safety.largeOutputLinesThreshold": {
					"type": "number",
					"default": 50000,
					"minimum": 100,
					"description": "%manifest.settings.safety.warn.large-output.desc%"
				},
				"paths-le.statusBar.enabled": {
					"type": "boolean",
					"default": true,
					"description": "%manifest.settings.statusbar.enabled.desc%"
				},
				"paths-le.telemetryEnabled": {
					"type": "boolean",
					"default": false,
					"description": "%manifest.settings.telemetry.desc%"
				},
				"paths-le.resolution.resolveSymlinks": {
					"type": "boolean",
					"default": false,
					"description": "%manifest.settings.resolution.symlinks.desc%",
					"markdownDescription": "%manifest.settings.resolution.symlinks.markdown%"
				},
				"paths-le.resolution.resolveWorkspaceRelative": {
					"type": "boolean",
					"default": false,
					"description": "%manifest.settings.resolution.workspace.desc%",
					"markdownDescription": "%manifest.settings.resolution.workspace.markdown%"
				}
			}
		}
	},
	"scripts": {
		"clean": "node -e \"const fs=require('fs');['dist','coverage','release'].forEach(d=>fs.rmSync(d,{recursive:true,force:true}))\"",
		"clean:i18n": "node -e \"const fs=require('fs');fs.readdirSync('.').filter(f=>f.startsWith('package.nls.')&&f.endsWith('.json')&&f!=='package.nls.json').forEach(f=>fs.unlinkSync(f))\"",
		"copy:i18n": "node -e \"const fs=require('fs');fs.readdirSync('src/i18n').forEach(f=>fs.copyFileSync('src/i18n/'+f,f))\"",
		"build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node20 --main-fields=module,main --sourcemap",
		"build:prod": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node20 --main-fields=module,main --minify --sourcemap=external",
		"watch": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node20 --main-fields=module,main --sourcemap --watch",
		"typecheck": "tsc --noEmit",
		"check:bundle": "node scripts/check-bundle.js",
		"test": "vitest run --pool=threads",
		"test:watch": "vitest --pool=threads",
		"test:coverage": "vitest run --coverage --pool=threads",
		"test:integration": "npm run build && tsc -p tsconfig.it.json && vscode-test",
		"test:e2e-vsix": "node scripts/e2e-vsix.js",
		"lint": "biome check src/",
		"lint:fix": "biome check --write src/",
		"vscode:prepublish": "npm run typecheck && npm run build:prod && npm run check:bundle && npm run copy:i18n",
		"package": "node -e \"require('fs').mkdirSync('release',{recursive:true})\" && vsce package --no-dependencies --out release/ && npm run clean:i18n",
		"publish": "vsce publish"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@types/mocha": "^10.0.10",
		"@types/node": "^26.1.2",
		"@types/vscode": "1.90.0",
		"@vitest/coverage-v8": "^4.1.10",
		"@vitest/ui": "^4.1.10",
		"@vscode/test-cli": "^0.0.15",
		"@vscode/test-electron": "^3.1.0",
		"@vscode/vsce": "^3.9.2",
		"esbuild": "^0.28.1",
		"mocha": "^11.8.0",
		"ovsx": "^1.1.0",
		"tsx": "^4.23.5",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@iarna/toml": "^2.2.5",
		"csv-parse": "^7.0.2",
		"jsonc-parser": "^3.3.1"
	}
}
